#include "kernel/types.h"
#include "kernel/stat.h"
#include "user/user.h"

int
main(int argc, char *argv[])
{
	int n;
	int prime;
	int p1[2];		// Pipe from parent to the child.
	int p2[2];		// Pipe from the child to its child.
	
	if(argc == 1){
		pipe(p1);			// Create the pipe.
		
		// Create a child that only create the childs
		// and connect with pipe.
		if(fork() == 0){
			close(p1[1]);

			while(1){
				if(read(p1[0], &prime, 4) == 0){
					close(p1[0]);
					exit(0);
				}
				printf("prime %d\n", prime);
				pipe(p2);
				
				if(fork() == 0){
					close(p2[0]);
					
					while(read(p1[0], &n, 4) != 0){
						if(n % prime != 0){
							write(p2[1], &n, 4);
						}
					}
					close(p1[0]);
					close(p2[1]);
					exit(0);

				} else {
					close(p1[0]);
					close(p2[1]);
					p1[0] = p2[0];
				}
			}
		} else {
			close(p1[0]);
			
			for(n = 2; n <= 280; n++){
				write(p1[1], &n, 4);
			}
			close(p1[1]);
			wait(0);
		}
	} else {
		fprintf(2, "Error: primes doesn't require any arguments.\n");
	}
	exit(0);
}
